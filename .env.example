# Copy to .env and edit. Never commit .env.
# Paper trading is the default. Live trading needs BOTH flags below.

PAPER_TRADING=true
LIVE_TRADING_CONFIRM=false

# binance or bybit
EXCHANGE_ID=binance
# spot (default) or swap (required for short entries on a live exchange)
MARKET_TYPE=spot
# Swap only. Keep 1 on spot.
LEVERAGE=1
EXCHANGE_SANDBOX=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=

# Strategy: trend (Donchian breakout with a 50/200 EMA filter) or legacy (original indicator mix).
# Run `python main.py backtest --strategy all` before trusting either one.
STRATEGY=trend
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=4h
LOOP_INTERVAL_MINUTES=15
# trend needs >= 212, legacy >= 61
OHLCV_LIMIT=300

# Risk. Fractions: 0.01 is 1%.
# RISK_PER_TRADE is the loss if the stop fills at its price (max 0.05).
RISK_PER_TRADE=0.01
REWARD_RISK_RATIO=3.0
# Checked AFTER round-trip fees and slippage.
MIN_REWARD_RISK=1.5
MIN_CONFIDENCE=0.55
MAX_OPEN_POSITIONS=3
# Per-position notional cap and the cap on all open notional, vs equity.
MAX_NOTIONAL_PCT=0.5
MAX_TOTAL_EXPOSURE_PCT=1.0
# Blocks new entries until the next UTC day.
DAILY_MAX_LOSS_PCT=0.05
# Kill switch: drawdown from the equity peak. Stays on until you reset it in the dashboard.
MAX_DRAWDOWN_PCT=0.20
COOLDOWN_MINUTES=60
USE_ATR_STOPS=true
ATR_MULTIPLIER=2.5
FIXED_STOP_PCT=0.03
ALLOW_SHORT=false
ORDER_TYPE=market
# Resting limit entries are cancelled after this long.
PENDING_ORDER_TTL_MINUTES=60
FEE_RATE=0.001
# Paper and backtest assume this much adverse slippage on market fills.
SLIPPAGE_PCT=0.0005
MIN_NOTIONAL=10
STARTING_BALANCE=10000
QUOTE_CURRENCY=USDT

# Local web dashboard: http://127.0.0.1:8765
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Required for Docker or any non-local bind. Use a long random string.
DASHBOARD_TOKEN=

# Optional. Notifications are skipped when either value is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional headline source. RSS is used when this is empty or the API fails.
CRYPTOPANIC_TOKEN=
FEAR_GREED_URL=https://api.alternative.me/fng/?limit=1
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
REQUEST_TIMEOUT_SECONDS=15
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
# Prefix of every clientOrderId the bot sends. Used to find orphan orders at startup.
CLIENT_ORDER_PREFIX=ctb
DECISIONS_RETENTION_DAYS=90
